# Volunteer Management System — server-side environment variables.
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER put these in HTML/JS files or commit a real .env file.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role key bypasses Row-Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the anon/public key, used only for staff sign-in calls.
SUPABASE_ANON_KEY=

# A long random string used to hash IP addresses for rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
THROTTLE_SALT=
